{
  "name": "history-of",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Interactive world-history timeline",
  "homepage": "https://<username>.github.io/history-of",
  "repository": {
    "type": "git",
    "url": "https://github.com/<username>/history-of.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check": "pnpm run svelte-check && eslint . && pnpm run lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:fix": "pnpm run svelte-check && eslint . && pnpm run format"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flightlesslabs/dodo-ui": "^0.36.15",
    "@iconify/svelte": "^5.2.4",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/enhanced-img": "^0.4.3",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "storybook": "10.6.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.4",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^0.8.0"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-zoom": "^3.0.0"
  }
}
